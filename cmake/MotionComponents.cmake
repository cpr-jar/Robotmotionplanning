# Dependencies point from consumers to providers. Header-only selection needs no packages.
set(MOTION_KNOWN_COMPONENTS
  core contracts math kinematics planning execution tracking platform
  serial_kinematics differential_kinematics calibration dxf_import model_import
  program ruckig following serial)
set(motion_deps_core "")
set(motion_deps_contracts core)
set(motion_deps_math core)
set(motion_deps_kinematics core math)
set(motion_deps_planning contracts math kinematics)
set(motion_deps_execution contracts planning)
set(motion_deps_tracking math execution planning)
set(motion_deps_platform core)
set(motion_deps_serial_kinematics kinematics)
set(motion_deps_differential_kinematics kinematics)
set(motion_deps_calibration math)
set(motion_deps_dxf_import math)
set(motion_deps_model_import serial_kinematics)
set(motion_deps_program model_import dxf_import planning execution)
set(motion_deps_ruckig planning)
set(motion_deps_following tracking ruckig differential_kinematics)
# Historical compiled library, including its former single-archive contents.
set(motion_deps_serial serial_kinematics differential_kinematics calibration model_import dxf_import program)

function(motion_resolve_components output)
  set(pending ${ARGN})
  set(selected "")
  while(pending)
    list(POP_FRONT pending component)
    if(NOT component IN_LIST MOTION_KNOWN_COMPONENTS)
      message(FATAL_ERROR "Unknown motion component '${component}'. Available: ${MOTION_KNOWN_COMPONENTS}")
    endif()
    if(NOT component IN_LIST selected)
      list(APPEND selected ${component})
      list(APPEND pending ${motion_deps_${component}})
    endif()
  endwhile()
  set(${output} ${selected} PARENT_SCOPE)
endfunction()

function(motion_link_component_dependencies target visibility component)
  foreach(dependency IN LISTS motion_deps_${component})
    target_link_libraries(${target} ${visibility} RobotMotion::${dependency})
  endforeach()
endfunction()

function(motion_header_component component)
  add_library(robot_motion_${component} INTERFACE)
  add_library(RobotMotion::${component} ALIAS robot_motion_${component})
  if(component STREQUAL "core")
    target_include_directories(robot_motion_core INTERFACE ${PROJECT_SOURCE_DIR}/include)
    target_compile_features(robot_motion_core INTERFACE cxx_std_20)
    if(MOTION_SANITIZE AND NOT MSVC)
      target_compile_options(robot_motion_core INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
      target_link_options(robot_motion_core INTERFACE -fsanitize=address,undefined)
    endif()
  endif()
  motion_link_component_dependencies(robot_motion_${component} INTERFACE ${component})
endfunction()

function(motion_compiled_component component)
  cmake_parse_arguments(PART "" "" "SOURCES;PRIVATE;DEFINITIONS" ${ARGN})
  # Compile once; component and historical archives reuse the same objects.
  add_library(robot_motion_${component}_objects OBJECT ${PART_SOURCES})
  motion_link_component_dependencies(robot_motion_${component}_objects PRIVATE ${component})
  target_link_libraries(robot_motion_${component}_objects PRIVATE ${PART_PRIVATE})
  # Use dependency usage requirements, also when a parent already supplied a parser target.
  foreach(dependency IN LISTS PART_PRIVATE)
    if(TARGET ${dependency})
      get_target_property(motion_private_includes ${dependency} INTERFACE_INCLUDE_DIRECTORIES)
      if(motion_private_includes)
        target_include_directories(robot_motion_${component}_objects SYSTEM PRIVATE ${motion_private_includes})
      endif()
    endif()
  endforeach()
  target_compile_definitions(robot_motion_${component}_objects PRIVATE ${PART_DEFINITIONS})
  motion_strict_target(robot_motion_${component}_objects)
  add_library(robot_motion_${component} STATIC $<TARGET_OBJECTS:robot_motion_${component}_objects>)
  add_library(RobotMotion::${component} ALIAS robot_motion_${component})
  motion_link_component_dependencies(robot_motion_${component} PUBLIC ${component})
  target_link_libraries(robot_motion_${component} PRIVATE ${PART_PRIVATE})
  target_compile_definitions(robot_motion_${component} PUBLIC ${PART_DEFINITIONS})
endfunction()
