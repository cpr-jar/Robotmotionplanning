include(FetchContent)
function(motion_dependencies)
  set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
  set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
  set(BUILD_SHARED_LIBS OFF)
  set(BUILD_TESTING OFF)
  set(tinyxml2_BUILD_TESTING OFF)
  set(YAML_CPP_BUILD_TESTS OFF)
  set(YAML_CPP_BUILD_TOOLS OFF)
  set(YAML_CPP_INSTALL OFF)
  FetchContent_Declare(motion_eigen SOURCE_SUBDIR motion_header_only URL ${PROJECT_SOURCE_DIR}/third_party/source_archives/eigen-3.4.0.tar.gz URL_HASH SHA256=8586084f71f9bde545ee7fa6d00288b264a2b7ac3607b974e54d13e7162c1c72)
  FetchContent_Declare(motion_yaml URL ${PROJECT_SOURCE_DIR}/third_party/source_archives/yaml-cpp-0.8.0.tar.gz URL_HASH SHA256=fbe74bbdcee21d656715688706da3c8becfd946d92cd44705cc6098bb23b3a16)
  FetchContent_Declare(motion_xml URL ${PROJECT_SOURCE_DIR}/third_party/source_archives/tinyxml2-11.0.0.tar.gz URL_HASH SHA256=5556deb5081fb246ee92afae73efd943c889cef0cafea92b0b82422d6a18f289)
  FetchContent_MakeAvailable(motion_eigen motion_yaml motion_xml)
  add_library(motion_eigen_headers INTERFACE)
  target_include_directories(motion_eigen_headers SYSTEM INTERFACE ${motion_eigen_SOURCE_DIR})
endfunction()

function(motion_ruckig_dependency)
  set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
  set(BUILD_CLOUD_CLIENT OFF)
  set(BUILD_EXAMPLES OFF)
  set(BUILD_TESTS OFF)
  FetchContent_Declare(ruckig URL ${PROJECT_SOURCE_DIR}/third_party/source_archives/ruckig-0.15.3.tar.gz URL_HASH SHA256=ddde1186a9ee1dde09416f2769c43536b48b0200912327d4216313286895b0be)
  FetchContent_MakeAvailable(ruckig)
endfunction()
