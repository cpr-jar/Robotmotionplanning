function(motion_strict_target target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /WX)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
  endif()
endfunction()

function(motion_executable target source)
  add_executable(${target} ${source})
  target_link_libraries(${target} PRIVATE RobotMotion::motion)
  set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR})
  motion_strict_target(${target})
endfunction()
